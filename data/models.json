  "meta": {
    "updated": "2026-09-20",
    "note": "体积为 HF 仓库原始字节换算的 GB（十进制）。quant = 量化族。rel_l2 = 社区/作者公布的权重相对误差（越低越好）。speed_mod = 相对 int8 的单步速度系数（引擎用）。所有条目均经 HF API 文件清单核实（2026-09-18）。",
    "base_model": "MiniMax H3 (33.1B dense single-stream omni transformer, Qwen3-VL-32B text encoder)",
    "min_viable_set_gb": 42.5,
    "quant_families": {
      "bf16": {
        "label": "BF16 全精度",
        "bits": 16,
        "note": "未量化基线",
        "speed_mod": 0.55
      },
      "fp8": {
        "label": "FP8 Scaled",
        "bits": 8,
        "note": "cu130 int8 内核不可用时的回退方案",
        "speed_mod": 0.9
      },
      "int8": {
        "label": "INT8 ConvRot",
        "bits": 8,
        "note": "官方推荐，需 PyTorch cu130",
        "speed_mod": 1.0
      },
      "w4a8": {
        "label": "W4A8（4位权重+INT8计算）",
        "bits": 4,
        "note": "ConvRot int4 + Lloyd-Max 码本，relL2≈0.073（优于 NVFP4 0.094），比 INT8 快约 9%，无需校准；需 ComfyUI ≥0.31",
        "speed_mod": 1.09
      },
      "nvfp4": {
        "label": "NVFP4（4位浮点）",
        "bits": 4,
        "note": "relL2≈0.094；扩散模型需 Blackwell (50 系)，text encoder 不限",
        "speed_mod": 1.15
      },
      "gguf": {
        "label": "GGUF（llama.cpp 量化）",
        "bits": 4,
        "note": "兼容性最好、体积可到最小，但注意力内核效率较低",
        "speed_mod": 0.8
      },
      "int4": {
        "label": "INT4 ConvRot",
        "bits": 4,
        "note": "4 位权重 ConvRot 打包（simple/实验性），任意 GPU 可用；质量与速度均未充分评估",
        "speed_mod": 0.95
      }
    },
